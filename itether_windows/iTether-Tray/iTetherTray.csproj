<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>iTetherTray</AssemblyName>
    <RootNamespace>iTether</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AssemblyTitle>iTether Tray</AssemblyTitle>
    <Product>iTether</Product>
    <Description>Replaces iTunes/Apple Devices for iPhone USB Personal Hotspot tethering on Windows.</Description>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Update="..\iTether.psm1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>iTether.psm1</Link>
    </None>
    <None Update="..\INF\itether_usbncm.inf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>itether_usbncm.inf</Link>
    </None>
  </ItemGroup>

</Project>
